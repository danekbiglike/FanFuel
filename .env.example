# Шаблон переменных окружения FanFuel.
# Не хранить реальные секреты в этом файле.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_ALLOWED_DEV_ORIGINS=danechka.com
API_BASE_URL=http://localhost:8080
FANFUEL_INTERNAL_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8081
VITE_WS_BASE_URL=ws://localhost:8081
NEXT_PUBLIC_WIDGET_BASE_URL=http://localhost:5173
DEFAULT_LOCALE=ru
NEXT_PUBLIC_DEFAULT_LOCALE=ru
VITE_DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en
NEXT_PUBLIC_DEFAULT_CURRENCY=RUB
VITE_DEFAULT_CURRENCY=RUB
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
WEB_PORT=3000
ADMIN_PORT=3001
WIDGET_PORT=5173
API_PORT=8080
WS_PORT=8081
WORKER_PORT=8082

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fanfuel
POSTGRES_USER=fanfuel
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgres://fanfuel:change_me_in_local_env@postgres:5432/fanfuel?sslmode=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_me_in_local_env
SESSION_SECRET=change_me_in_local_env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_PUBLIC_BUCKET=fanfuel-public
S3_PRIVATE_BUCKET=fanfuel-private
S3_ACCESS_KEY_ID=change_me_in_local_env
S3_SECRET_ACCESS_KEY=change_me_in_local_env
CDN_BASE_URL=http://localhost:9000/fanfuel-public
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=mock
SAFE_DEAL_PROVIDER=mock
FISCALIZATION_PROVIDER=mock
TOME_API_KEY=
TOME_SECRET_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.local

ADMIN_BOOTSTRAP_EMAIL=admin@example.local
