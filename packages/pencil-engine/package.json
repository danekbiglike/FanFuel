{
  "name": "@fanfuel/pencil-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "vite build demo --config vite.config.ts",
    "build:playground": "vite build playground --config vite.playground.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit && tsc -p tsconfig.playground.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "demo": "vite demo --config vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
