{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@fanfuel/i18n": ["packages/i18n/src/index.ts"],
      "@fanfuel/sdk": ["packages/sdk/src/index.ts"],
      "@fanfuel/types": ["packages/types/src/index.ts"],
      "@fanfuel/ui": ["packages/ui/src/index.ts"]
    }
  }
}
